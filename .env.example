# MicroShop : configuration locale (aucun secret).
# Copier ce fichier en ".env" à la racine du projet pour surcharger les valeurs par défaut.
# Sans fichier .env, les valeurs ci-dessous sont utilisées par défaut.

# --- Users Service (Express) ---
USERS_SERVICE_PORT=4101

# --- Orders Service (Express) ---
ORDERS_SERVICE_PORT=4102

# --- URL internes (appels serveur à serveur) ---
# Utilisée par orders-service et par la passerelle Next.js pour joindre users-service.
USERS_SERVICE_URL=http://localhost:4101
# Utilisée par la passerelle Next.js pour joindre orders-service.
ORDERS_SERVICE_URL=http://localhost:4102

# --- URL publiques (appels depuis le navigateur, intégrées au build Next.js) ---
NEXT_PUBLIC_USERS_SERVICE_URL=http://localhost:4101
NEXT_PUBLIC_ORDERS_SERVICE_URL=http://localhost:4102

# --- CORS : origines autorisées par les microservices (séparées par des virgules) ---
# Next.js écoute sur le port 3000 (fixé dans apps/web/package.json).
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
